{
  "entities": {
    "Expense": {
      "title": "Expense",
      "description": "Represents a single expense record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "driverId": { "type": "string" },
        "freightValue": { "type": "number" },
        "licensePlate": { "type": "string" },
        "destination": { "type": "string" },
        "clientName": { "type": "string" },
        "thirdPartyFreight": { "type": "number" },
        "seguro": { "type": "number" },
        "invoice": { "type": "string" },
        "fueling": { "type": "number" },
        "entryOdometer": { "type": "number" },
        "exitOdometer": { "type": "number" },
        "driverExpenses": { "type": "number" },
        "toll": { "type": "number" },
        "loadingUnloading": { "type": "number" },
        "fines": { "type": "number" },
        "others": { "type": "number" },
        "type": { "type": "string", "enum": ["internal", "external"] }
      },
      "required": ["date", "driverId", "freightValue", "licensePlate", "destination", "type"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Represents a driver profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "UserRecord": {
      "title": "UserRecord",
      "description": "Represents an ERP user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string" },
        "profilePicture": { "type": "string" }
      },
      "required": ["username", "role"]
    }
  },
  "firestore": {
    "/erp_accounts/{accountId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "A collection of expenses for a specific ERP account."
    },
    "/erp_accounts/{accountId}/drivers/{driverId}": {
      "schema": { "$ref": "#/entities/Driver" },
      "description": "A collection of drivers for a specific ERP account."
    },
    "/erp_accounts/{accountId}/users/{userId}": {
      "schema": { "$ref": "#/entities/UserRecord" },
      "description": "A collection of ERP application users for a specific ERP account."
    }
  }
}
